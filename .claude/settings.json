{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push origin*)",
      "Bash(git rev-parse*)",
      "Bash(git symbolic-ref*)",
      "Bash(git ls-files*)",
      "Bash(bash .claude/hooks/auto_commit.sh*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash .claude/hooks/auto_commit.sh",
            "timeout": 120,
            "statusMessage": "Auto-commit and push changes"
          }
        ]
      }
    ]
  }
}
